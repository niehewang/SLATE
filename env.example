# Example paths for a portable reproduction environment.
# Frozen stage scripts may still refer to the original server layout; use these
# values when adapting the path-resolution constants or creating symlinks.
SLATE_PYTHON=/path/to/python
SLATE_WORK_ROOT=/path/to/slate_work
SLATE_SHARED_ROOT=/path/to/SLATE_TDSC_SERVER_SHARED
SLATE_QWEN_PATH=/path/to/Qwen3-4B-Base
SLATE_PHI_PATH=/path/to/Phi-3-mini-4k-instruct
SLATE_EMBED_PATH=/path/to/Qwen3-Embedding-8B
SLATE_MPNET_PATH=/path/to/all-mpnet-base-v2
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
